# Optional private/local override only. Do not use this for public hosting unless this is a private app.
# Prefer the in-app temporary cookies.txt upload flow for public deployments.
# YTDLP_COOKIES_FILE=cookies.txt

# Optional local-only alternative. This is not suitable for Render or other public hosts.
# YTDLP_COOKIES_FROM_BROWSER=chrome

# Automatic YouTube Proof-of-Origin token support.
# The production Docker image bundles the matching provider at this URL.
POT_PROVIDER_ENABLED=true
POT_PROVIDER_URL=http://127.0.0.1:4416

# Optional local provider entry point. Without this file, local development
# gracefully uses the normal yt-dlp client path.
# POT_PROVIDER_SERVER=C:/path/to/bgutil-ytdlp-pot-provider/server/build/main.js

# Comma-separated exact frontend origins. Do not include paths.
# CORS_ORIGIN=http://localhost:3000,https://your-custom-domain.example
#
# Render and GitHub Pages origins are also accepted by the default hosted-origin
# regex. Override this only when you need a stricter or different host policy.
# CORS_ORIGIN_REGEX=^https://your-frontend-domain\.example$
